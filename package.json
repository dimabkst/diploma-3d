{
  "name": "diploma-3d",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.0.0 <13"
  },
  "scripts": {
    "dev": "pnpm --filter @diploma-3d/web dev",
    "build": "pnpm --filter @diploma-3d/web build",
    "preview": "pnpm --filter @diploma-3d/web preview",
    "typecheck": "tsc --project tsconfig.json && tsc --project packages/schema/tsconfig.json && tsc --project packages/engine/tsconfig.json && svelte-check --tsconfig apps/web/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.1",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
